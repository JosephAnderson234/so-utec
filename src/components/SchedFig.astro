---
/** Diagramas de planificación en monoprocesador (Stallings cap. 9): colas, quantum, prioridades, Gantt, VRR, feedback, α, ρ, UNIX y fair-share. */
import '../styles/svgfig.css';
type Fig =
	| 'colas' | 'quantum' | 'prioridad' | 'gantt' | 'vrr' | 'feedback' | 'alfa' | 'rho' | 'unix' | 'fss'
	| 'inttrap' | 'manejo' | 'anidadas' | 'mitades' | 'spinirq' | 'rafagas' | 'convoy' | 'decide' | 'dispatcher' | 'metricas' | 'tau';
type Pol = 'FCFS' | 'RR1' | 'RR4' | 'SPN' | 'SRT' | 'HRRN' | 'FB1' | 'FB2';
interface Props {
	fig: Fig;
	filas?: Pol[];
}
const { fig, filas } = Astro.props;
const A = `url(#sca-${fig})`;
const R = `url(#scr-${fig})`;
const defs = `<defs><marker id="sca-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head"/></marker><marker id="scr-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head-bad"/></marker><pattern id="sch-${fig}" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="8" class="hatch"/></pattern></defs>`;
const H = `url(#sch-${fig})`;

const procs = [
	{ n: 'A', a: 0, s: 3 },
	{ n: 'B', a: 2, s: 6 },
	{ n: 'C', a: 4, s: 4 },
	{ n: 'D', a: 6, s: 5 },
	{ n: 'E', a: 8, s: 2 },
];
const color: Record<string, string> = { A: 'c1', B: 'c3', C: 'c5', D: 'c2', E: 'c4' };
const gantt: Record<Pol, { t: string; seq: string; tr: string }> = {
	FCFS: { t: 'FCFS', seq: 'AAABBBBBBCCCCDDDDDEE', tr: '8.60' },
	RR1: { t: 'RR q = 1', seq: 'AABABCBDCBEDCBEDCBDD', tr: '10.80' },
	RR4: { t: 'RR q = 4', seq: 'AAABBBBCCCCDDDDBBEED', tr: '10.00' },
	SPN: { t: 'SPN', seq: 'AAABBBBBBEECCCCDDDDD', tr: '7.60' },
	SRT: { t: 'SRT', seq: 'AAABCCCCEEBBBBBDDDDD', tr: '7.20' },
	HRRN: { t: 'HRRN', seq: 'AAABBBBBBCCCCEEDDDDD', tr: '8.00' },
	FB1: { t: 'FB q = 1', seq: 'AABACBDCEDEBCDBCDBDB', tr: '10.00' },
	FB2: { t: 'FB q = 2ⁱ', seq: 'AABACBBDECCDDEBBBCDD', tr: '10.60' },
};
const rows = (filas ?? (Object.keys(gantt) as Pol[])).map((k) => gantt[k]);
const GX = 110;
const GW = 28;
const GH = 30;
const gTop = 64;
const gHeight = gTop + rows.length * GH + 70;
const fins = (seq: string) => procs.map((p) => seq.lastIndexOf(p.n) + 1);

const alfa = (a: number) => Array.from({ length: 8 }, (_, i) => a * (1 - a) ** i);
const rhoPts = Array.from({ length: 46 }, (_, i) => {
	const r = i * 0.02;
	return `${80 + r * 600},${270 - (1 / (1 - r) - 1) * 24}`;
}).join(' ');
const unix = [
	{ p: [60, 60, 60], run: 'A' },
	{ p: [75, 60, 60], run: 'B' },
	{ p: [67, 75, 60], run: 'C' },
	{ p: [63, 67, 75], run: 'A' },
	{ p: [76, 63, 67], run: 'B' },
	{ p: [68, 76, 63], run: 'C' },
];
const fss = [
	{ p: [60, 60, 60], run: 'A' },
	{ p: [90, 60, 60], run: 'B' },
	{ p: [74, 90, 75], run: 'A' },
	{ p: [96, 74, 67], run: 'C' },
	{ p: [78, 81, 93], run: 'A' },
	{ p: [98, 70, 76], run: 'B' },
];
const prioTabla = fig === 'unix' ? unix : fss;
---

<figure class="svgfig not-content">
	<div class="svgfig__scroll">
		{fig === 'colas' && (
			<svg viewBox="0 0 760 330" role="img" aria-label="Diagrama de colas: el largo plazo admite, el corto plazo elige de la cola de listos, el mediano plazo mueve procesos a disco">
				<Fragment set:html={defs} />
				<text x="20" y="84" class="t s l">nuevo</text>
				<text x="20" y="100" class="t s l">trabajo</text>
				<line x1="68" y1="86" x2="92" y2="86" class="ln" marker-end={A} />
				<rect x="94" y="64" width="100" height="44" rx="8" class="c1" />
				<text x="144" y="84" class="t s b">largo plazo</text>
				<text x="144" y="100" class="t s">¿lo admito?</text>
				<line x1="194" y1="86" x2="228" y2="86" class="ln" marker-end={A} />
				<text x="230" y="60" class="t s l b">cola de listos (RAM)</text>
				<rect x="230" y="70" width="180" height="32" rx="4" class="box" />
				{[0, 1, 2, 3, 4].map((k) => <line x1={266 + k * 36} y1="70" x2={266 + k * 36} y2="102" class="sep" />)}
				<line x1="410" y1="86" x2="434" y2="86" class="ln" marker-end={A} />
				<rect x="436" y="64" width="100" height="44" rx="8" class="c3" />
				<text x="486" y="84" class="t s b">corto plazo</text>
				<text x="486" y="100" class="t s">¿quién corre?</text>
				<line x1="536" y1="86" x2="560" y2="86" class="ln" marker-end={A} />
				<rect x="562" y="64" width="80" height="44" rx="8" class="c4" />
				<text x="602" y="91" class="t b">CPU</text>
				<line x1="642" y1="86" x2="676" y2="86" class="ln" marker-end={A} />
				<text x="680" y="91" class="t s l">termina</text>
				<path d="M602 64 V30 H392 V68" class="ln" marker-end={A} />
				<text x="460" y="24" class="t s">expropiado (se acabó el quantum o llegó alguien mejor)</text>
				<path d="M602 108 V176 H412" class="ln" marker-end={A} />
				<text x="612" y="150" class="t s l">pide E/S o</text>
				<text x="612" y="166" class="t s l">espera un evento</text>
				<text x="230" y="152" class="t s l b">cola de bloqueados (RAM)</text>
				<rect x="230" y="160" width="180" height="32" rx="4" class="box" />
				{[0, 1, 2, 3, 4].map((k) => <line x1={266 + k * 36} y1="160" x2={266 + k * 36} y2="192" class="sep" />)}
				<line x1="392" y1="158" x2="392" y2="106" class="ln ok" marker-end={A} />
				<text x="400" y="136" class="t s l ok">ocurre el evento</text>
				<rect x="30" y="236" width="170" height="56" rx="8" class="c2" />
				<text x="115" y="258" class="t s b">disco (swap)</text>
				<text x="115" y="276" class="t s">procesos suspendidos</text>
				<path d="M228 184 H140 V234" class="ln dash" marker-end={A} />
				<text x="146" y="214" class="t s l">swap out</text>
				<path d="M80 234 V140 H250 V106" class="ln dash" marker-end={A} />
				<text x="86" y="132" class="t s l">swap in</text>
				<rect x="240" y="236" width="500" height="56" rx="8" class="box" />
				<text x="252" y="258" class="t s l"><tspan class="b">Mediano plazo</tspan> (flechas punteadas): decide quién está en RAM y quién en disco.</text>
				<text x="252" y="278" class="t s l">Largo y mediano plazo controlan <tspan class="b">cuántos</tspan> procesos compiten; corto plazo, <tspan class="b">cuál</tspan> corre.</text>
				<text x="380" y="318" class="t s mu">Forma de las figuras 9.1 y 9.3 de Stallings, simplificada.</text>
			</svg>
		)}

		{fig === 'quantum' && (
			<svg viewBox="0 0 760 270" role="img" aria-label="Quantum mayor que una interacción: la respuesta tarda s. Quantum menor: el proceso es expropiado y la respuesta tarda mucho más">
				<Fragment set:html={defs} />
				<text x="20" y="40" class="t s l b">(a) q un poco mayor</text>
				<text x="20" y="56" class="t s l b">que la interacción</text>
				<path d="M200 30 V24 H520 V30" class="ln" />
				<text x="360" y="18" class="t s">quantum q</text>
				<rect x="200" y="36" width="240" height="28" class="c4" />
				<text x="320" y="55" class="t s b">interacción completa (s)</text>
				<rect x="440" y="36" width="80" height="28" class="cell-off" />
				<text x="480" y="55" class="t s mu">sobra</text>
				<line x1="200" y1="82" x2="438" y2="82" class="ln ok" marker-end={A} />
				<text x="320" y="100" class="t s ok b">tiempo de respuesta = s</text>

				<text x="20" y="160" class="t s l b">(b) q menor que</text>
				<text x="20" y="176" class="t s l b">la interacción</text>
				<path d="M200 150 V144 H320 V150" class="ln" />
				<text x="260" y="138" class="t s">q</text>
				<rect x="200" y="156" width="120" height="28" class="c4" />
				<text x="260" y="175" class="t s b">parte 1</text>
				<rect x="320" y="156" width="260" height="28" class="cell" />
				<text x="450" y="175" class="t s">corren los otros procesos</text>
				<rect x="580" y="156" width="120" height="28" class="c4" />
				<text x="640" y="175" class="t s b">parte 2</text>
				<line x1="200" y1="202" x2="698" y2="202" class="ln bad" marker-end={R} />
				<text x="450" y="220" class="t s bad b">tiempo de respuesta = s + la espera en la cola</text>
				<text x="380" y="256" class="t s mu">Fig. 9.6: con q muy chico, además, cada cambio de proceso suma overhead.</text>
			</svg>
		)}

		{fig === 'prioridad' && (
			<svg viewBox="0 0 760 260" role="img" aria-label="Colas de prioridad RQ0 a RQn: el dispatcher toma de la cola más alta que no está vacía">
				<Fragment set:html={defs} />
				{[
					['RQ0', [], 'c1'],
					['RQ1', ['P5', 'P2'], 'c1'],
					['RQ2', ['P7'], 'c1'],
					['RQn', ['P4', 'P9', 'P1'], 'c1'],
				].map(([q, ps], i) => (
					<>
						<text x="60" y={52 + i * 50} class="t s r b">{q}</text>
						<rect x="70" y={32 + i * 50} width="260" height="30" rx="4" class="box" />
						{(ps as string[]).map((p, k) => (
							<>
								<rect x={290 - k * 50} y={35 + i * 50} width="36" height="24" rx="4" class={i === 1 ? 'c4' : 'c3'} />
								<text x={308 - k * 50} y={52 + i * 50} class="t s b">{p}</text>
							</>
						))}
						{(ps as string[]).length === 0 && <text x="200" y={52 + i * 50} class="t s mu">vacía</text>}
					</>
				))}
				<text x="200" y="177" class="t s mu">⋮</text>
				<path d="M330 97 H440" class="ln ok" stroke-width="2.5" marker-end={A} />
				<rect x="442" y="76" width="90" height="42" rx="8" class="c4" />
				<text x="487" y="102" class="t b">CPU</text>
				<text x="380" y="88" class="t s ok">P2</text>
				<text x="560" y="58" class="t s l">El dispatcher revisa de arriba</text>
				<text x="560" y="74" class="t s l">abajo y toma la primera cola</text>
				<text x="560" y="90" class="t s l">que <tspan class="b">no esté vacía</tspan>: RQ1.</text>
				<text x="560" y="182" class="t s l bad b">RQn solo corre si todas</text>
				<text x="560" y="198" class="t s l bad">las de arriba están vacías:</text>
				<text x="560" y="214" class="t s l bad">riesgo de starvation.</text>
				<text x="380" y="250" class="t s mu">Fig. 9.4. Convención del libro: RQ0 es la de mayor prioridad. Procesos de ejemplo propio.</text>
			</svg>
		)}

		{fig === 'gantt' && (
			<svg viewBox={`0 0 760 ${gHeight}`} role="img" aria-label={`Diagramas de Gantt del ejemplo de Stallings para ${rows.map((r) => r.t).join(', ')}`}>
				<text x={GX - 10} y="20" class="t s r mu">llega</text>
				{procs.map((p) => (
					<>
						<line x1={GX + p.a * GW} y1="26" x2={GX + p.a * GW} y2={gTop - 4} class="ln" />
						<text x={GX + p.a * GW + 3} y="20" class="t s l b">{p.n}<tspan class="mu"> ({p.s})</tspan></text>
					</>
				))}
				<text x={GX + 20 * GW + 52} y="56" class="t s b">Tr medio</text>
				{rows.map((r, i) => (
					<>
						<text x={GX - 10} y={gTop + i * GH + 20} class="t s r b">{r.t}</text>
						{r.seq.split('').map((c, k) => (
							<>
								<rect x={GX + k * GW + 1} y={gTop + i * GH + 2} width={GW - 2} height={GH - 4} rx="3" class={color[c]} />
								<text x={GX + k * GW + GW / 2} y={gTop + i * GH + 20} class="t s b">{c}</text>
							</>
						))}
						<text x={GX + 20 * GW + 52} y={gTop + i * GH + 20} class="t s mono b">{r.tr}</text>
					</>
				))}
				{Array.from({ length: 21 }, (_, k) => (
					<text x={GX + k * GW} y={gTop + rows.length * GH + 16} class="t s mu">{k % 5 === 0 || rows.length === 1 ? k : ''}</text>
				))}
				<text x={GX + 10 * GW} y={gTop + rows.length * GH + 40} class="t s mu">tiempo →  ·  Tr = fin − llegada; Tr medio de los 5 procesos (tabla 9.5)</text>
				{rows.length === 1 && (
					<text x={GX + 10 * GW} y={gTop + rows.length * GH + 60} class="t s">fin: {procs.map((p, k) => `${p.n} = ${fins(rows[0].seq)[k]}`).join(' · ')}</text>
				)}
			</svg>
		)}

		{fig === 'vrr' && (
			<svg viewBox="0 0 760 270" role="img" aria-label="Virtual Round Robin: los procesos que vuelven de E/S van a una cola auxiliar con preferencia">
				<Fragment set:html={defs} />
				<text x="20" y="72" class="t s l">admitido</text>
				<line x1="80" y1="68" x2="118" y2="68" class="ln" marker-end={A} />
				<text x="120" y="44" class="t s l b">cola principal (FCFS)</text>
				<rect x="120" y="52" width="180" height="32" rx="4" class="box" />
				<text x="120" y="134" class="t s l b ok">cola auxiliar (FCFS)</text>
				<rect x="120" y="142" width="180" height="32" rx="4" class="c4" />
				<path d="M300 68 H360 V100 H398" class="ln" marker-end={A} />
				<path d="M300 158 H360 V114 H398" class="ln ok" stroke-width="2.5" marker-end={A} />
				<text x="310" y="196" class="t s l ok b">tiene preferencia</text>
				<rect x="400" y="84" width="90" height="44" rx="8" class="c4" />
				<text x="445" y="111" class="t b">CPU</text>
				<line x1="490" y1="106" x2="530" y2="106" class="ln" marker-end={A} />
				<text x="534" y="110" class="t s l">termina</text>
				<path d="M445 84 V20 H280 V50" class="ln" marker-end={A} />
				<text x="330" y="14" class="t s">se le acabó el quantum → cola principal</text>
				<path d="M445 128 V230 H640" class="ln" marker-end={A} />
				<text x="540" y="222" class="t s">pide E/S</text>
				<rect x="642" y="206" width="100" height="48" rx="8" class="box" />
				<text x="692" y="228" class="t s b">E/S</text>
				<text x="692" y="244" class="t s mu">(bloqueado)</text>
				<path d="M692 206 V160 H302" class="ln ok" marker-end={A} />
				<text x="560" y="152" class="t s ok">termina la E/S → cola auxiliar</text>
				<text x="210" y="226" class="t s l">Al salir de la auxiliar, el proceso</text>
				<text x="210" y="242" class="t s l">corre solo <tspan class="b">lo que le quedaba</tspan> de su quantum.</text>
			</svg>
		)}

		{fig === 'feedback' && (
			<svg viewBox="0 0 760 270" role="img" aria-label="Feedback: un proceso nuevo entra a RQ0 y baja una cola cada vez que agota su quantum">
				<Fragment set:html={defs} />
				<text x="20" y="44" class="t s l">nuevo</text>
				<line x1="66" y1="40" x2="98" y2="40" class="ln" marker-end={A} />
				{[
					['RQ0', 'q = 1'],
					['RQ1', 'q = 2'],
					['RQ2', 'q = 4'],
					['RQn', 'RR'],
				].map(([q, qq], i) => (
					<>
						<rect x="100" y={i === 3 ? 200 : 24 + i * 62} width="200" height="32" rx="4" class="box" />
						<text x="110" y={i === 3 ? 221 : 45 + i * 62} class="t s l b">{q}</text>
						<line x1="300" y1={i === 3 ? 216 : 40 + i * 62} x2="420" y2={i === 3 ? 216 : 40 + i * 62} class="ln" marker-end={A} />
						<rect x="422" y={i === 3 ? 196 : 20 + i * 62} width="80" height="40" rx="8" class="c4" />
						<text x="462" y={i === 3 ? 221 : 45 + i * 62} class="t s b">CPU</text>
						<text x="360" y={i === 3 ? 208 : 32 + i * 62} class="t s mu">{qq}</text>
						<line x1="502" y1={i === 3 ? 216 : 40 + i * 62} x2="540" y2={i === 3 ? 216 : 40 + i * 62} class="ln" marker-end={A} />
						<text x="544" y={i === 3 ? 220 : 44 + i * 62} class="t s l">termina</text>
					</>
				))}
				{[0, 1].map((i) => (
					<path d={`M462 ${60 + i * 62} V${72 + i * 62} H200 V${84 + i * 62}`} class="ln bad" marker-end={R} />
				))}
				<text x="200" y="194" class="t s mu">⋮</text>
				<text x="620" y="70" class="t s l bad b">agotó el quantum</text>
				<text x="620" y="86" class="t s l bad">→ baja una cola</text>
				<text x="620" y="130" class="t s l">El dispatcher siempre</text>
				<text x="620" y="146" class="t s l">toma de la cola más alta</text>
				<text x="620" y="162" class="t s l">que no esté vacía.</text>
				<text x="380" y="262" class="t s mu">Fig. 9.10. Con q = 1 en todas es «FB q = 1»; con q = 2ⁱ, la variante para no estirar tanto a los largos.</text>
			</svg>
		)}

		{fig === 'alfa' && (
			<svg viewBox="0 0 760 260" role="img" aria-label="Peso de las últimas 8 observaciones en el promedio exponencial: con alfa 0.8 casi todo está en las primeras; con alfa 0.2 se reparte">
				{[0.8, 0.2].map((a, g) => (
					<>
						<text x={190 + g * 380} y="24" class="t b">α = {a}</text>
						<line x1={40 + g * 380} y1="200" x2={340 + g * 380} y2="200" class="axis" />
						{alfa(a).map((w, k) => (
							<>
								<rect x={50 + g * 380 + k * 36} y={200 - w * 190} width="26" height={w * 190} class={g === 0 ? 'c3' : 'c1'} />
								<text x={63 + g * 380 + k * 36} y={194 - w * 190} class="t s">{w.toFixed(2).replace(/^0/, '')}</text>
								<text x={63 + g * 380 + k * 36} y="216" class="t s mu">T{k === 0 ? 'n' : `n−${k}`}</text>
							</>
						))}
					</>
				))}
				<text x="190" y="240" class="t s">reacciona rápido; olvida pronto</text>
				<text x="570" y="240" class="t s">suaviza los picos; reacciona lento</text>
				<text x="380" y="256" class="t s mu">Altura = peso de cada ráfaga pasada en Sₙ₊₁ = α Tₙ + (1 − α) Sₙ. La de la izquierda es la más reciente.</text>
			</svg>
		)}

		{fig === 'rho' && (
			<svg viewBox="0 0 760 300" role="img" aria-label="Turnaround normalizado 1 sobre 1 menos rho: crece despacio hasta 0.5 y se dispara cerca de 1">
				<line x1="80" y1="276" x2="80" y2="20" class="axis" />
				<line x1="80" y1="276" x2="700" y2="276" class="axis" />
				<polyline points={rhoPts} class="curve" fill="none" />
				{[
					[0.5, 2],
					[0.8, 5],
					[0.9, 10],
				].map(([r, v]) => (
					<>
						<line x1={80 + r * 600} y1="276" x2={80 + r * 600} y2={270 - (v - 1) * 24} class="ln dash" />
						<circle cx={80 + r * 600} cy={270 - (v - 1) * 24} r="5" class="cell-on" />
						<text x={80 + r * 600 - 10} y={266 - (v - 1) * 24} class="t s r b">Tr/Ts = {v}</text>
						<text x={80 + r * 600} y="292" class="t s">ρ = {r}</text>
					</>
				))}
				<text x="80" y="292" class="t s">0</text>
				<text x="748" y="292" class="t s r b">utilización ρ →</text>
				<text x="88" y="24" class="t s l b">Tr/Ts</text>
				<text x="120" y="80" class="t s l">Tr/Ts = 1 / (1 − ρ)</text>
				<text x="120" y="98" class="t s l mu">para cualquier política que elija</text>
				<text x="120" y="114" class="t s l mu">sin mirar el tiempo de servicio</text>
				<text x="120" y="232" class="t s l">con poca carga casi no hay cola</text>
			</svg>
		)}

		{(fig === 'unix' || fig === 'fss') && (
