				<polyline points={[10, 8, 6, 6, 5, 9, 11, 12].map((v, i) => `${102 + i * 76},${250 - v * 14}`).join(' ')} class="ln ok" fill="none" stroke-width="2.5" />
				{[10, 8, 6, 6, 5, 9, 11, 12].map((v, i) => (
					<>
						<circle cx={102 + i * 76} cy={250 - v * 14} r="5" class="cell-on" />
						<text x={102 + i * 76} y={240 - v * 14} class="t s ok b">{v}</text>
						<text x={102 + i * 76} y="270" class="t s mu">{i}</text>
					</>
				))}
				<text x="720" y="270" class="t s r">n →</text>
				<rect x="440" y="20" width="16" height="12" class="c3" /><text x="462" y="31" class="t s l">ráfaga real tₙ</text>
				<circle cx="590" cy="26" r="5" class="cell-on" /><text x="600" y="31" class="t s l ok">estimación τₙ</text>
			</svg>
		)}

	</div>
	<figcaption><slot /></figcaption>
</figure>
