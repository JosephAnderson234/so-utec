				<text x="480" y="104" class="t s l">guardar en PCB₀ · cargar de PCB₁ y saltar al PC</text>
				<text x="300" y="30" class="t s">el scheduler ya eligió a P1; el dispatcher hace el cambio</text>
			</svg>
		)}

		{fig === 'metricas' && (
			<svg viewBox="0 0 760 260" role="img" aria-label="Métricas de P4 en el RR del ejemplo: response 6, waiting 7 y turnaround 11">
				<Fragment set:html={defs} />
				<text x="56" y="44" class="t s r b">CPU</text>
				{[[0, 3, 'P1', 'c1'], [3, 6, 'P2', 'c3'], [6, 9, 'P1', 'c1'], [9, 11, 'P3', 'c5'], [11, 14, 'P4', 'c4'], [14, 15, 'P1', 'c1'], [15, 16, 'P4', 'c4']].map(([a, b, n, c]) => (
					<>
						<rect x={60 + (a as number) * 40} y="26" width={((b as number) - (a as number)) * 40} height="28" rx="3" class={c as string} />
						<text x={60 + (((a as number) + (b as number)) / 2) * 40} y="45" class="t s b">{n}</text>
					</>
				))}
				<text x="56" y="114" class="t s r b">P4</text>
				<rect x="260" y="96" width="240" height="28" rx="3" class="hole" fill={H} />
				<rect x="500" y="96" width="120" height="28" rx="3" class="c4" />
				<rect x="620" y="96" width="40" height="28" rx="3" class="hole" fill={H} />
				<rect x="660" y="96" width="40" height="28" rx="3" class="c4" />
				<text x="380" y="88" class="t s">en la cola de listos</text>
				<text x="560" y="88" class="t s b">corre</text>
				<line x1="260" y1="66" x2="260" y2="94" class="ln" marker-end={A} />
				<text x="252" y="80" class="t s r">llega (5)</text>
				<path d="M260 140 V148 H500 V140" class="ln" />
				<text x="380" y="164" class="t s b">response = 11 − 5 = 6</text>
				<text x="380" y="186" class="t s">waiting = 6 + 1 = <tspan class="b">7</tspan> (las dos zonas rayadas)</text>
				<path d="M260 204 V212 H700 V204" class="ln" />
				<text x="480" y="230" class="t s b">turnaround = 16 − 5 = 11</text>
				{[0, 5, 10, 15, 16].map((t) => <text x={60 + t * 40} y="252" class="t s mu">{t}</text>)}
			</svg>
		)}

		{fig === 'tau' && (
			<svg viewBox="0 0 760 290" role="img" aria-label="Ráfagas reales y estimaciones con alfa 0.5: la estimación sigue a la real con retraso">
				<Fragment set:html={defs} />
				<line x1="70" y1="250" x2="720" y2="250" class="axis" marker-end={A} />
				<line x1="70" y1="250" x2="70" y2="40" class="axis" marker-end={A} />
				{[2, 4, 6, 8, 10, 12].map((v) => (
					<>
						<line x1="70" y1={250 - v * 14} x2="700" y2={250 - v * 14} class="sep" stroke-dasharray="2 6" />
