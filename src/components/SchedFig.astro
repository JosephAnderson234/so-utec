				<text x="60" y="144" class="t s r b">P1</text>
				<rect x="70" y="46" width="230" height="28" rx="4" class="c1" />
				<text x="185" y="65" class="t s">corre</text>
				<line x1="300" y1="60" x2="720" y2="60" class="ln dash" />
				<text x="620" y="52" class="t s mu">en espera</text>
				<line x1="70" y1="140" x2="460" y2="140" class="ln dash" />
				<text x="160" y="132" class="t s mu">en espera</text>
				<rect x="460" y="126" width="260" height="28" rx="4" class="c3" />
				<text x="590" y="145" class="t s">corre</text>
				<rect x="300" y="84" width="80" height="32" rx="4" class="trap" />
				<text x="340" y="104" class="t s b">guarda P0</text>
				<rect x="380" y="84" width="80" height="32" rx="4" class="trap" />
				<text x="420" y="104" class="t s b">carga P1</text>
