---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	function init() {
		// Barra de progreso de lectura
		let bar = document.getElementById('scroll-progress');
		if (!bar) {
			bar = document.createElement('div');
			bar.id = 'scroll-progress';
			document.body.appendChild(bar);
		}
		const update = () => {
			const h = document.documentElement.scrollHeight - innerHeight;
			bar!.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
		};
		addEventListener('scroll', update, { passive: true });
		update();

		// Spotlight que sigue al mouse en las tarjetas
		document.querySelectorAll<HTMLElement>('.so-card').forEach((c) => {
			c.addEventListener('pointermove', (e) => {
				const r = c.getBoundingClientRect();
				c.style.setProperty('--mx', `${e.clientX - r.left}px`);
				c.style.setProperty('--my', `${e.clientY - r.top}px`);
			});
		});

		if (reduce) return;

		// Hero: entrada escalonada
		const hero = document.querySelector('.so-hero');
		if (hero) {
			gsap.from(hero.querySelectorAll('[data-anim]'), { y: 28, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.09 });
		}

		// Tarjetas y estadísticas: aparición al hacer scroll
		ScrollTrigger.batch('.so-card, .so-stats > div', {
			start: 'top 92%',
			onEnter: (els) => gsap.fromTo(els, { y: 26, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', stagger: 0.06, overwrite: true }),
		});

		// Contadores animados
		document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
			const to = Number(el.dataset.count);
			const obj = { v: 0 };
			ScrollTrigger.create({
				trigger: el,
				start: 'top 95%',
				once: true,
				onEnter: () => gsap.to(obj, { v: to, duration: 1.4, ease: 'power2.out', onUpdate: () => (el.textContent = String(Math.round(obj.v))) }),
			});
		});

		// Encabezados h2: pequeño deslizamiento
		gsap.utils.toArray<HTMLElement>('.sl-markdown-content > h2, .sl-markdown-content > .sl-heading-wrapper.level-h2').forEach((h) => {
			gsap.from(h, { x: -16, opacity: 0, duration: 0.6, ease: 'power2.out', scrollTrigger: { trigger: h, start: 'top 90%', once: true } });
		});
	}

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
	else init();
</script>
