---
/** Diagramas de la arquitectura de segmentación: traducción, mapa lógico/físico, compartición y x86. */
interface Props {
	fig: 'traduccion' | 'mapa' | 'compartir' | 'x86';
}
const { fig } = Astro.props;
---

<figure class="segfig not-content">
	<div class="segfig__scroll">
		{fig === 'traduccion' && (
			<svg viewBox="0 0 760 420" role="img" aria-label="Traducción de la dirección lógica (1, 50) a la física 3050 con STLR, STBR y la tabla de segmentos">
				<defs>
					<marker id="sf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="head" /></marker>
					<marker id="sf-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="head-bad" /></marker>
				</defs>

				<text x="240" y="24" class="cap">dirección lógica = (s, d)</text>
				<rect x="20" y="40" width="80" height="44" rx="8" class="box" />
				<text x="60" y="67" class="t b">CPU</text>
				<line x1="100" y1="62" x2="148" y2="62" class="ln" marker-end="url(#sf-a)" />
				<rect x="150" y="40" width="80" height="44" rx="6" class="c1" />
				<text x="190" y="67" class="t b">s = 1</text>
				<rect x="230" y="40" width="100" height="44" rx="6" class="c2" />
				<text x="280" y="67" class="t b">d = 50</text>

				<rect x="20" y="150" width="130" height="56" rx="8" class="box" />
				<text x="85" y="174" class="t b">STLR = 3</text>
				<text x="85" y="194" class="t s">cuántos segmentos hay</text>
				<rect x="20" y="310" width="130" height="56" rx="8" class="box" />
				<text x="85" y="334" class="t b">STBR</text>
				<text x="85" y="354" class="t s">dónde está la tabla</text>

				<path d="M190 84 V118 H250 V142" class="ln" marker-end="url(#sf-a)" />
				<line x1="150" y1="178" x2="178" y2="178" class="ln" marker-end="url(#sf-a)" />
				<polygon points="180,178 250,144 320,178 250,212" class="q" />
				<text x="250" y="176" class="t b">¿s &lt; STLR?</text>
				<text x="250" y="195" class="t s ok">1 &lt; 3 ✓</text>

				<line x1="250" y1="212" x2="250" y2="238" class="ln bad" marker-end="url(#sf-r)" />
				<text x="262" y="230" class="t s bad l">no</text>
				<rect x="190" y="240" width="120" height="36" rx="8" class="trap" />
				<text x="250" y="263" class="t s b bad">trap: s inválido</text>

				<line x1="320" y1="178" x2="398" y2="178" class="ln" marker-end="url(#sf-a)" />
				<text x="336" y="170" class="t s ok l">sí</text>
				<path d="M150 338 H372 V138 H398" class="ln dash" marker-end="url(#sf-a)" />
				<text x="378" y="300" class="t s l">STBR + s</text>

				<text x="570" y="92" class="cap">tabla de segmentos (en RAM)</text>
				<rect x="400" y="100" width="340" height="118" rx="6" class="box" />
				<g class="hdr">
					<text x="420" y="119" class="t s b">s</text>
					<text x="460" y="119" class="t s b">V</text>
					<text x="520" y="119" class="t s b">permisos</text>
					<text x="600" y="119" class="t s b">límite</text>
					<text x="690" y="119" class="t s b">base</text>
				</g>
				<line x1="400" y1="128" x2="740" y2="128" class="sep" />
				<text x="420" y="148" class="t">0</text><text x="460" y="148" class="t">1</text><text x="520" y="148" class="t mono">R-X</text><text x="600" y="148" class="t">500</text><text x="690" y="148" class="t">1000</text>
				<rect x="401" y="158" width="338" height="30" class="hl" />
				<text x="420" y="178" class="t b">1</text><text x="460" y="178" class="t b">1</text><text x="520" y="178" class="t mono b">RW-</text><text x="600" y="178" class="t b">200</text><text x="690" y="178" class="t b">3000</text>
				<text x="420" y="208" class="t mu">2</text><text x="460" y="208" class="t bad">0</text><text x="520" y="208" class="t mu">no válido</text><text x="600" y="208" class="t mu">—</text><text x="690" y="208" class="t mu">—</text>

				<line x1="570" y1="218" x2="570" y2="252" class="ln" marker-end="url(#sf-a)" />
				<polygon points="490,290 570,254 650,290 570,326" class="q" />
				<text x="570" y="282" class="t b">¿d &lt; límite?</text>
				<text x="570" y="300" class="t s ok">50 &lt; 200 ✓ · W ✓</text>

				<line x1="570" y1="326" x2="570" y2="352" class="ln bad" marker-end="url(#sf-r)" />
				<text x="582" y="344" class="t s bad l">no</text>
				<rect x="495" y="354" width="150" height="36" rx="8" class="trap" />
				<text x="570" y="377" class="t s b bad">segmentation fault</text>

				<line x1="650" y1="290" x2="678" y2="290" class="ln" marker-end="url(#sf-a)" />
				<text x="656" y="282" class="t s ok l">sí</text>
				<path d="M740 173 H752 V290 H722" class="ln dash" marker-end="url(#sf-a)" />
				<circle cx="700" cy="290" r="20" class="c4" />
				<text x="700" y="296" class="t b">+</text>
				<text x="700" y="252" class="t s">base + d</text>
				<line x1="700" y1="310" x2="700" y2="356" class="ln" marker-end="url(#sf-a)" />
				<rect x="655" y="358" width="95" height="50" rx="8" class="c4" />
				<text x="702" y="379" class="t s">física</text>
				<text x="702" y="398" class="t b">3050</text>
			</svg>
		)}

		{fig === 'mapa' && (
			<svg viewBox="0 0 760 470" role="img" aria-label="Vista lógica de tres segmentos y su ubicación no contigua en la memoria física, con huecos">
				<defs>
					<marker id="sf-a2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head" /></marker>
					<pattern id="sf-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="8" class="hatch" /></pattern>
				</defs>
				<text x="130" y="24" class="cap">lo que ve el programa (lógica)</text>
				<text x="600" y="24" class="cap">memoria física</text>

				<rect x="40" y="50" width="180" height="70" rx="8" class="c1" />
				<text x="130" y="80" class="t b">segmento 0 · código</text>
				<text x="130" y="100" class="t s">offsets 0 … 499</text>
				<rect x="40" y="170" width="180" height="50" rx="8" class="c2" />
				<text x="130" y="192" class="t b">segmento 1 · datos</text>
				<text x="130" y="210" class="t s">offsets 0 … 199</text>
				<rect x="40" y="270" width="180" height="64" rx="8" class="c3" />
				<text x="130" y="298" class="t b">segmento 2 · pila</text>
				<text x="130" y="318" class="t s">offsets 0 … 399</text>
				<text x="130" y="378" class="t s mu">cada segmento empieza en su offset 0</text>
				<text x="130" y="396" class="t s mu">y tiene su propio tamaño</text>

				<rect x="520" y="40" width="160" height="80" class="os" />
				<text x="600" y="85" class="t s b">SO</text>
				<rect x="520" y="120" width="160" height="20" fill="url(#sf-hatch)" class="hole" />
				<rect x="520" y="140" width="160" height="50" class="c1" />
				<text x="600" y="170" class="t s b">seg. 0</text>
				<rect x="520" y="190" width="160" height="50" fill="url(#sf-hatch)" class="hole" />
				<text x="600" y="219" class="t s mu">hueco</text>
				<rect x="520" y="240" width="160" height="40" class="c3" />
				<text x="600" y="265" class="t s b">seg. 2</text>
				<rect x="520" y="280" width="160" height="60" fill="url(#sf-hatch)" class="hole" />
				<text x="600" y="314" class="t s mu">hueco</text>
				<rect x="520" y="340" width="160" height="20" class="c2" />
				<text x="600" y="355" class="t s b">seg. 1</text>
				<rect x="520" y="360" width="160" height="80" fill="url(#sf-hatch)" class="hole" />
				<text x="600" y="404" class="t s mu">hueco</text>
				<rect x="520" y="40" width="160" height="400" class="frame" />

				<g class="tick">
					<text x="512" y="44" class="t s r">0</text>
					<text x="512" y="144" class="t s r">1000</text>
					<text x="512" y="194" class="t s r">1500</text>
					<text x="512" y="244" class="t s r">2000</text>
					<text x="512" y="284" class="t s r">2400</text>
					<text x="512" y="344" class="t s r">3000</text>
					<text x="512" y="364" class="t s r">3200</text>
					<text x="512" y="444" class="t s r">4000</text>
				</g>

				<path d="M220 85 C 360 85, 360 165, 456 165" class="ln" marker-end="url(#sf-a2)" />
				<path d="M220 195 C 360 195, 360 350, 456 350" class="ln" marker-end="url(#sf-a2)" />
				<path d="M220 302 C 360 302, 360 260, 456 260" class="ln" marker-end="url(#sf-a2)" />
				<text x="452" y="181" class="t s r">base 1000</text>
				<text x="452" y="252" class="t s r">base 2000</text>
				<text x="452" y="366" class="t s r">base 3000</text>
				<text x="380" y="462" class="t s mu">Los huecos entre segmentos son fragmentación externa.</text>
			</svg>
		)}

		{fig === 'compartir' && (
			<svg viewBox="0 0 760 330" role="img" aria-label="Dos procesos comparten el segmento de código del editor y tienen segmentos de datos propios">
				<defs>
					<marker id="sf-a3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head" /></marker>
				</defs>
				<text x="150" y="24" class="cap">tablas de segmentos</text>
				<text x="620" y="24" class="cap">memoria física</text>

				<text x="30" y="56" class="t b l">P1</text>
				<rect x="60" y="38" width="250" height="88" rx="6" class="box" />
				<text x="80" y="58" class="t s b">s</text><text x="140" y="58" class="t s b">permisos</text><text x="220" y="58" class="t s b">base</text><text x="280" y="58" class="t s b">lím.</text>
				<line x1="60" y1="66" x2="310" y2="66" class="sep" />
				<rect x="61" y="67" width="248" height="28" class="hl" />
				<text x="80" y="86" class="t">0</text><text x="140" y="86" class="t mono">R-X</text><text x="220" y="86" class="t">4000</text><text x="280" y="86" class="t">900</text>
				<text x="80" y="115" class="t">1</text><text x="140" y="115" class="t mono">RW-</text><text x="220" y="115" class="t">6000</text><text x="280" y="115" class="t">300</text>

				<text x="30" y="198" class="t b l">P2</text>
				<rect x="60" y="180" width="250" height="88" rx="6" class="box" />
				<text x="80" y="200" class="t s b">s</text><text x="140" y="200" class="t s b">permisos</text><text x="220" y="200" class="t s b">base</text><text x="280" y="200" class="t s b">lím.</text>
				<line x1="60" y1="208" x2="310" y2="208" class="sep" />
				<rect x="61" y="209" width="248" height="28" class="hl" />
				<text x="80" y="228" class="t">0</text><text x="140" y="228" class="t mono">R-X</text><text x="220" y="228" class="t">4000</text><text x="280" y="228" class="t">900</text>
				<text x="80" y="257" class="t">1</text><text x="140" y="257" class="t mono">RW-</text><text x="220" y="257" class="t">7000</text><text x="280" y="257" class="t">250</text>

				<rect x="540" y="40" width="160" height="90" rx="6" class="c1" />
				<text x="620" y="78" class="t b">editor (código)</text>
				<text x="620" y="98" class="t s">4000 · compartido</text>
				<rect x="540" y="150" width="160" height="50" rx="6" class="c2" />
				<text x="620" y="180" class="t s b">datos de P1 · 6000</text>
				<rect x="540" y="220" width="160" height="46" rx="6" class="c5" />
				<text x="620" y="248" class="t s b">datos de P2 · 7000</text>

				<path d="M310 81 C 420 81, 430 80, 536 80" class="ln" marker-end="url(#sf-a3)" />
				<path d="M310 223 C 430 223, 420 110, 536 100" class="ln" marker-end="url(#sf-a3)" />
				<path d="M310 110 C 430 110, 430 175, 536 175" class="ln dash" marker-end="url(#sf-a3)" />
				<path d="M310 252 C 430 252, 430 243, 536 243" class="ln dash" marker-end="url(#sf-a3)" />

				<rect x="60" y="284" width="640" height="34" rx="8" class="trap" />
				<text x="380" y="306" class="t s bad">Si P1 intenta escribir en su segmento 0 (no tiene W), la MMU da una violación de protección.</text>
			</svg>
		)}

		{fig === 'x86' && (
			<svg viewBox="0 0 760 300" role="img" aria-label="En x86, el registro de segmento ES selecciona un descriptor de la GDT o la LDT; base más offset da la dirección lineal">
				<defs>
					<marker id="sf-a4" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head" /></marker>
				</defs>
				<rect x="20" y="20" width="200" height="40" rx="8" class="box" />
				<text x="120" y="45" class="t mono b">mov [es:bx], ax</text>
				<text x="120" y="80" class="t s mu">la instrucción nombra el segmento</text>

				<text x="20" y="110" class="cap l">registros de segmento</text>
				<g>
					<rect x="20" y="120" width="90" height="26" rx="4" class="box" /><text x="65" y="138" class="t s">CS · código</text>
					<rect x="20" y="150" width="90" height="26" rx="4" class="box" /><text x="65" y="168" class="t s">DS · datos</text>
					<rect x="20" y="180" width="90" height="26" rx="4" class="box" /><text x="65" y="198" class="t s">SS · pila</text>
					<rect x="20" y="210" width="90" height="26" rx="4" class="c1" /><text x="65" y="228" class="t s b">ES · extra</text>
					<rect x="20" y="240" width="90" height="26" rx="4" class="box" /><text x="65" y="258" class="t s">FS, GS</text>
				</g>

				<line x1="110" y1="223" x2="168" y2="223" class="ln" marker-end="url(#sf-a4)" />
				<text x="305" y="186" class="cap">selector (16 bits)</text>
				<rect x="170" y="200" width="100" height="44" rx="4" class="c1" /><text x="220" y="227" class="t s b">índice</text>
				<rect x="270" y="200" width="40" height="44" rx="4" class="c6" /><text x="290" y="227" class="t s b">TI</text>
				<rect x="310" y="200" width="50" height="44" rx="4" class="c3" /><text x="335" y="227" class="t s b">RPL</text>
				<text x="290" y="266" class="t s mu">TI: 0 = GDT · 1 = LDT</text>
				<text x="335" y="284" class="t s mu">en CS, el RPL es el privilegio actual (CPL)</text>

				<path d="M220 200 V140 H398" class="ln" marker-end="url(#sf-a4)" />
				<text x="470" y="96" class="cap">GDT / LDT (en RAM)</text>
				<rect x="400" y="104" width="160" height="110" rx="6" class="box" />
				<rect x="401" y="128" width="158" height="26" class="hl" />
				<text x="480" y="146" class="t s b">descriptor</text>
				<text x="480" y="174" class="t s">base · límite · DPL</text>
				<text x="480" y="196" class="t s mu">· tipo · presente</text>

				<line x1="560" y1="141" x2="606" y2="141" class="ln" marker-end="url(#sf-a4)" />
				<circle cx="626" cy="141" r="20" class="c4" /><text x="626" y="147" class="t b">+</text>
				<text x="652" y="146" class="t s l">base + bx</text>
				<path d="M220 40 H 626 V119" class="ln dash" marker-end="url(#sf-a4)" />
				<text x="430" y="32" class="t s mu">offset = bx</text>
				<line x1="626" y1="161" x2="626" y2="198" class="ln" marker-end="url(#sf-a4)" />
				<rect x="556" y="200" width="140" height="44" rx="8" class="c4" />
				<text x="626" y="219" class="t s b">dirección lineal</text>
				<text x="626" y="236" class="t s mu">→ luego, paginación</text>
			</svg>
		)}
	</div>
	<figcaption><slot /></figcaption>
</figure>

<style>
	.segfig {
		margin: 1.4rem 0;
		border: 1px solid var(--pg-border);
		border-radius: var(--pg-radius-sm);
		background: var(--pg-surface);
		padding: 0.8rem 0.8rem 0.6rem;
	}
	.segfig__scroll {
		overflow-x: auto;
	}
	.segfig svg {
		display: block;
		width: 100%;
		min-width: 560px;
		height: auto;
		font-family: var(--sl-font);
	}
	.segfig figcaption {
		margin-top: 0.5rem;
		font-size: 0.86rem;
		color: var(--pg-muted);
		line-height: 1.55;
	}
	.t {
		fill: var(--sl-color-white);
		font-size: 14px;
		text-anchor: middle;
	}
	.t.s {
		font-size: 12px;
	}
	.t.b {
		font-weight: 700;
	}
	.t.l {
		text-anchor: start;
	}
	.t.r {
		text-anchor: end;
	}
	.t.mono {
		font-family: var(--__sl-font-mono);
	}
	.t.mu,
	.cap {
		fill: var(--pg-muted);
	}
	.cap {
		font-size: 12px;
		text-anchor: middle;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.cap.l {
		text-anchor: start;
	}
	.t.ok {
		fill: var(--pg-ok);
	}
	.t.bad {
		fill: var(--pg-bad);
	}
	.box {
		fill: var(--pg-surface-2);
		stroke: var(--pg-border);
		stroke-width: 1.5;
	}
	.frame {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.os {
		fill: var(--sl-color-gray-5);
	}
	.hole {
		stroke: none;
	}
	.hatch {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.sep {
		stroke: var(--pg-border);
	}
	.hl {
		fill: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
	}
	.q {
		fill: color-mix(in srgb, var(--pg-c6) 14%, var(--pg-surface));
		stroke: var(--pg-c6);
		stroke-width: 1.5;
	}
	.trap {
		fill: color-mix(in srgb, var(--pg-bad) 12%, var(--pg-surface));
		stroke: var(--pg-bad);
		stroke-width: 1.2;
	}
	.c1,
	.c2,
	.c3,
	.c4,
	.c5,
	.c6 {
		stroke-width: 1.5;
	}
	.c1 { fill: color-mix(in srgb, var(--pg-c1) 22%, var(--pg-surface)); stroke: var(--pg-c1); }
	.c2 { fill: color-mix(in srgb, var(--pg-c2) 22%, var(--pg-surface)); stroke: var(--pg-c2); }
	.c3 { fill: color-mix(in srgb, var(--pg-c3) 22%, var(--pg-surface)); stroke: var(--pg-c3); }
	.c4 { fill: color-mix(in srgb, var(--pg-c4) 22%, var(--pg-surface)); stroke: var(--pg-c4); }
	.c5 { fill: color-mix(in srgb, var(--pg-c5) 22%, var(--pg-surface)); stroke: var(--pg-c5); }
	.c6 { fill: color-mix(in srgb, var(--pg-c6) 22%, var(--pg-surface)); stroke: var(--pg-c6); }
	.ln {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.ln.bad {
		stroke: var(--pg-bad);
	}
	.ln.dash {
		stroke-dasharray: 5 4;
	}
	.head {
		fill: var(--sl-color-gray-3);
	}
	.head-bad {
		fill: var(--pg-bad);
	}
</style>
