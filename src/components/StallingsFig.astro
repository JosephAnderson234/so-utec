				<rect x="530" y="90" width="210" height="44" rx="8" class="c4" />
				<text x="635" y="110" class="t s b">acceso a memoria</text>
				<text x="635" y="126" class="t s">dentro de la imagen del proceso</text>
				<line x1="400" y1="148" x2="400" y2="168" class="ln bad" marker-end={R} />
