				<text x="420" y="214" class="t s l bad">fragmentación interna.</text>
				<text x="420" y="242" class="t s l mu">Abajo, la memoria real, a escala.</text>
			</svg>
		)}

		{fig === 'reloc' && (
			<svg viewBox="0 0 760 230" role="img" aria-label="Relocalización con registros base y límite: base más relativa, comparar con el límite">
				<Fragment set:html={defs} />
				<rect x="20" y="90" width="140" height="44" rx="8" class="box" />
				<text x="90" y="110" class="t s b">dirección relativa</text>
				<text x="90" y="126" class="t s mu">del programa</text>
				<rect x="180" y="16" width="120" height="40" rx="6" class="c1" /><text x="240" y="41" class="t s b">registro base</text>
				<line x1="240" y1="56" x2="240" y2="90" class="ln" marker-end={A} />
				<line x1="160" y1="112" x2="218" y2="112" class="ln" marker-end={A} />
				<circle cx="240" cy="112" r="20" class="c4" /><text x="240" y="118" class="t b">+</text>
				<line x1="260" y1="112" x2="338" y2="112" class="ln" marker-end={A} />
				<text x="300" y="104" class="t s">absoluta</text>
				<rect x="340" y="16" width="120" height="40" rx="6" class="c3" /><text x="400" y="41" class="t s b">registro límite</text>
				<line x1="400" y1="56" x2="400" y2="74" class="ln" marker-end={A} />
				<polygon points="340,112 400,76 460,112 400,148" class="q" />
