				<rect x="320" y="170" width="160" height="40" rx="8" class="trap" />
				<text x="400" y="195" class="t s b bad">interrupción al SO</text>
				<text x="620" y="190" class="t s mu">Cambiar de lugar el proceso</text>
				<text x="620" y="206" class="t s mu">= cargar otra base</text>
			</svg>
		)}

		{fig === 'binding' && (
			<svg viewBox="0 0 760 210" role="img" aria-label="Momento del binding: programación, compilación, carga o ejecución; solo en ejecución se puede mover el proceso">
